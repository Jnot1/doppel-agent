#!/usr/bin/env python3
"""Deprecated compatibility wrapper for ``doppel gateway``.

This historical script name is kept so older contributor docs and local
muscle memory do not break abruptly. New user-facing guidance should point to
``doppel gateway ...`` instead.
"""

from __future__ import annotations

import os
import sys
from pathlib import Path


PROJECT_DIR = Path(__file__).resolve().parent.parent
if str(PROJECT_DIR) not in sys.path:
    sys.path.insert(0, str(PROJECT_DIR))
PROJECT_VENV_PYTHONS = (
    PROJECT_DIR / ".venv" / "bin" / "python",
    PROJECT_DIR / "venv" / "bin" / "python",
)


def main() -> None:
    print(
        "Deprecated wrapper: use `doppel gateway ...` instead of "
        "`./scripts/hermes-gateway ...`.",
        file=sys.stderr,
    )
    current_python = Path(sys.executable).resolve()
    for candidate in PROJECT_VENV_PYTHONS:
        if candidate.exists() and current_python != candidate.resolve():
            os.execv(
                str(candidate),
                [str(candidate), "-m", "hermes_cli.main", "gateway", *sys.argv[1:]],
            )
    from hermes_cli.main import main as cli_main
    sys.argv = ["doppel", "gateway", *sys.argv[1:]]
    cli_main()


if __name__ == "__main__":
    main()
